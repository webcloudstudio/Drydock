{
  "console": {
    "name": "Project Console",
    "default_item": "guide",
    "state_db": "data/console_state.sqlite"
  },
  "project": {
    "id": "PROJECT",
    "name": "Project Name",
    "description": "One-line description shown in the header."
  },

  "_comment": "items[] is a flat list of things — one thing = one nav entry (1:1). Nav properties: label, section (+ optional order). Section is the item's state; the sidebar groups by it (canonical: core/pages/plan/actions/archive). Type properties: type (markdown|editable_markdown|jsonl|kanban|questionnaire|link) + its fields. editable_markdown adds Edit/Save in the UI. jsonl renders configured fields from one-object-per-line records. All path values must resolve inside the project root.",

  "items": [
    {
      "id": "intent",
      "label": "Project Intent",
      "section": "core",
      "type": "editable_markdown",
      "path": "intent.md"
    },
    {
      "id": "guide",
      "label": "Guide",
      "section": "pages",
      "type": "markdown",
      "path": "pages/overview.md"
    },
    {
      "id": "board",
      "label": "Kanban",
      "section": "plan",
      "type": "kanban",
      "path": "tickets.json"
    },
    {
      "id": "kickoff",
      "label": "Kickoff Questionnaire",
      "section": "actions",
      "type": "questionnaire",
      "path": "questionnaires/kickoff.json"
    }
  ]
}
