#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ -x .venv/bin/python ]]; then
  pre_commit=(.venv/bin/python -m pre_commit run --hook-stage pre-commit)
elif command -v pre-commit >/dev/null 2>&1; then
  pre_commit=(pre-commit run --hook-stage pre-commit)
else
  printf 'pre-commit is not installed. Run: uv sync --extra dev\n' >&2
  exit 1
fi

exec bash bin/pre_commit_guard.sh "${pre_commit[@]}"
