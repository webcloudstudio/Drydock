# Drydock global configuration sample
# Copy relevant values to the user-scoped Drydock config file, or set these
# as environment variables. Do NOT commit your real .env.
#
# The real config file is written by: drydock config set <key> <path>
# Location: <user_config_path>/drydock/.env  (OS-appropriate directory)

SPECIFICATION_DIRECTORY=/absolute/path/to/your/specifications
TARGET_DIRECTORY=/absolute/path/to/your/target/projects
